# Copier en .env pour le développement local (jamais versionné).

# Base Postgres (Neon en production : DATABASE_URL = URL poolée, DIRECT_URL = URL directe)
DATABASE_URL="postgresql://signal:signal@db:5432/signal"
DIRECT_URL="postgresql://signal:signal@db:5432/signal"

# Secret de signature des cookies et de hachage des IP (32 octets aléatoires minimum)
APP_SECRET="change-me-with-openssl-rand-base64-48"

# URL publique du site (vérification d'origine, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Jev via Vercel AI Gateway (recommandé). En production sur Vercel, l'authentification OIDC
# est automatique ; la clé ne sert qu'en dehors de Vercel. Vide partout : revue manuelle.
AI_GATEWAY_API_KEY=""
JEV_GATEWAY_MODEL="typesafe-ai/jev"

# Jev en direct chez TypeSafe AI (alternative)
TYPESAFE_API_KEY=""
TYPESAFE_API_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL="jev-latest"
JEV_DAILY_LIMIT="5000"

# Embeddings pour les doublons (Voyage AI) — vide : repli sur la similarité textuelle pg_trgm
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5-lite"

# Cloudflare Turnstile — vides : vérification désactivée (dev uniquement)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (rate limiting) — vides : limiteur en mémoire (dev uniquement)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Interrupteur d'urgence : "true" envoie tout nouveau signalement en revue manuelle
MODERATION_FREEZE="false"

# Photos (désactivées en V1)
PHOTOS_ENABLED="false"

# Analytics Plausible (vide : désactivé)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Secret des tâches planifiées Vercel Cron
CRON_SECRET="change-me"
RATE_LIMIT_MULTIPLIER="1"
DEV_ALLOWED_ORIGINS=""
